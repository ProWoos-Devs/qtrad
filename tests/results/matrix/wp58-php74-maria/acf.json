{
    "environment": {
        "wordpress": "5.8",
        "php": "7.4.33",
        "acf": "6.0.7"
    },
    "passed": 28,
    "total": 28,
    "cases": [
        {
            "case": "qTranslate-XT field types are registered",
            "pass": true,
            "expected": [
                true,
                true,
                true,
                true,
                true,
                true,
                true
            ],
            "actual": [
                true,
                true,
                true,
                true,
                true,
                true,
                true
            ]
        },
        {
            "case": "values are stored with bracket markers",
            "pass": true,
            "expected": [
                "[:en]Hello[:de]Hallo[:]",
                "[:en]Std[:de]Standard[:]",
                "[:en]https://example.com/en[:de]https://example.com/de[:]",
                "Just text",
                "[:en]64[:]",
                "[:en]63[:de]62[:]"
            ],
            "actual": [
                "[:en]Hello[:de]Hallo[:]",
                "[:en]Std[:de]Standard[:]",
                "[:en]https://example.com/en[:de]https://example.com/de[:]",
                "Just text",
                "[:en]64[:]",
                "[:en]63[:de]62[:]"
            ]
        },
        {
            "case": "get_field returns the current language",
            "pass": true,
            "expected": [
                "Hallo",
                "Standard",
                "https://example.com/de",
                "Just text",
                62
            ],
            "actual": [
                "Hallo",
                "Standard",
                "https://example.com/de",
                "Just text",
                62
            ]
        },
        {
            "case": "missing translation falls back to the default language without a prefix",
            "pass": true,
            "expected": [
                "Hello",
                64,
                63
            ],
            "actual": [
                "Hello",
                64,
                63
            ]
        },
        {
            "case": "image without a translation in the language falls back too",
            "pass": true,
            "expected": 64,
            "actual": 64
        },
        {
            "case": "with every custom field translated, ACF fields still fall back without a prefix",
            "pass": true,
            "expected": [
                "Hello",
                63
            ],
            "actual": [
                "Hello",
                63
            ]
        },
        {
            "case": "ACF field read as plain custom field falls back without a prefix",
            "pass": true,
            "expected": "Hello",
            "actual": "Hello"
        },
        {
            "case": "standard field with the Translate setting renders per language",
            "pass": true,
            "expected": "qtranslate_text",
            "actual": "qtranslate_text"
        },
        {
            "case": "standard field whose value has markers renders per language",
            "pass": true,
            "expected": "qtranslate_text",
            "actual": "qtranslate_text"
        },
        {
            "case": "plain standard field stays as it is",
            "pass": true,
            "expected": "text",
            "actual": "text"
        },
        {
            "case": "field label is shown in the admin language",
            "pass": true,
            "expected": "Subtitle",
            "actual": "Subtitle"
        },
        {
            "case": "one input per language, the default language keeps the field id",
            "pass": true,
            "expected": [
                3,
                true,
                true,
                true
            ],
            "actual": [
                3,
                true,
                true,
                true
            ]
        },
        {
            "case": "only the default language input is required",
            "pass": true,
            "expected": 1,
            "actual": 1
        },
        {
            "case": "URL validated per language",
            "pass": true,
            "expected": true,
            "actual": true
        },
        {
            "case": "invalid URL in one language is reported with its name",
            "pass": true,
            "expected": "Deutsch: Value must be a valid URL",
            "actual": "Deutsch: Value must be a valid URL"
        },
        {
            "case": "required field needs the default language",
            "pass": true,
            "expected": "English: Subtitle is required",
            "actual": "English: Subtitle is required"
        },
        {
            "case": "character limit applies per language",
            "pass": true,
            "expected": "Deutsch: Value must not exceed 20 characters",
            "actual": "Deutsch: Value must not exceed 20 characters"
        },
        {
            "case": "posted language arrays are joined, also inside rows",
            "pass": true,
            "expected": [
                "[:en]A[:de]B\\'s[:]",
                "p",
                "[:en]x[:de]y[:]"
            ],
            "actual": [
                "[:en]A[:de]B\\'s[:]",
                "p",
                "[:en]x[:de]y[:]"
            ]
        },
        {
            "case": "ACF accepts valid per-language values",
            "pass": true,
            "expected": true,
            "actual": true
        },
        {
            "case": "ACF saves per-language values as one string",
            "pass": true,
            "expected": [
                "[:en]Saved[:de]Gespeichert[:]",
                "[:en]https://example.com/a[:de]https://example.com/b[:]"
            ],
            "actual": [
                "[:en]Saved[:de]Gespeichert[:]",
                "[:en]https://example.com/a[:de]https://example.com/b[:]"
            ]
        },
        {
            "case": "ACF rejects a missing default language and an invalid URL",
            "pass": true,
            "expected": [
                false,
                2
            ],
            "actual": [
                false,
                2
            ]
        },
        {
            "case": "ACF accepts per-language values of a marker-detected field",
            "pass": true,
            "expected": true,
            "actual": true
        },
        {
            "case": "saving keeps the translation of a language that is not enabled",
            "pass": true,
            "expected": "[:en]Hello edited[:de]Hallo[:es]Hola[:]",
            "actual": "[:en]Hello edited[:de]Hallo[:es]Hola[:]"
        },
        {
            "case": "marker-detected standard field is stored as a string, an emptied language is cleared",
            "pass": true,
            "expected": "[:en]Plain edited[:es]Hola[:]",
            "actual": "[:en]Plain edited[:es]Hola[:]"
        },
        {
            "case": "a field key validator still rejects a multilingual value",
            "pass": true,
            "expected": [
                false,
                "Rejected by custom rule"
            ],
            "actual": [
                false,
                "Rejected by custom rule"
            ]
        },
        {
            "case": "a later type validator returning false still rejects",
            "pass": true,
            "expected": false,
            "actual": false
        },
        {
            "case": "a per-language URL check is not tripped by the markers",
            "pass": true,
            "expected": true,
            "actual": true
        },
        {
            "case": "a qTranslate-XT field type keeps its key validators too",
            "pass": true,
            "expected": false,
            "actual": false
        }
    ]
}
